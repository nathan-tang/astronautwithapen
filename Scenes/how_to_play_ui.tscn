[node name="InstructionsLabel" type="RichTextLabel" parent="Panel/VBoxContainer/MarginContainer"]
layout_mode = 2
bbcode_enabled = true
text = "[b]OBJECTIVE[/b]
Defend your planets from alien enemies. Survive as long as possible!

[b]CONTROLS[/b]
[color=cyan]WASD / Arrow Keys[/color] - Move
[color=cyan]Space[/color] - Jump
[color=cyan]Left Click[/color] - Swing pen to attack
[color=cyan]Mouse[/color] - Draw shapes to cast spells

[b]DRAWING SPELLS[/b]
[color=yellow]Triangle[/color] - Fires a homing bullet (costs ink)
[color=yellow]Circle[/color] - Drops a bomb that explodes (costs ink)
[color=lime]TIP:[/color] Stand on bombs to launch yourself between planets!

[b]ENEMIES[/b]
[color=red]Slimes[/color] - Crawl on planets and attack them (1 point each)
[color=red]UFOs[/color] - Orbit planets and drop slimes (10 points each)

[b]WIN CONDITION[/b]
Survive and rack up the highest score before all planets are destroyed!"
fit_content = true
scroll_active = false

[node name="BackButton" type="Button" parent="Panel/VBoxContainer"]
custom_minimum_size = Vector2(200, 50)
layout_mode = 2
size_flags_horizontal = 4
text = "Back"
